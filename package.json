{
  "name": "powercontext-ts",
  "private": true,
  "version": "0.0.0",
  "description": "TypeScript PowerContext workspace for the official Client and parity implementation.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": "^22.12.0 || ^24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "pnpm -r --filter \"./packages/**\" build",
    "test": "vitest run",
    "test:client": "vitest run packages/protocol packages/client packages/core",
    "test:runtime": "vitest run packages/builtin packages/server packages/cli",
    "test:sqlite-spike": "vitest run tools/spikes/sqlite/sqlite-driver.test.ts",
    "pack:smoke": "node tools/pack-smoke/run.mjs",
    "license:check": "node tools/license-header/check.mjs",
    "deps:licenses": "node tools/dependency-governance/check.mjs",
    "deps:audit": "pnpm audit --audit-level high",
    "generate": "tsx tools/generate-protocol/src/cli.ts",
    "generate:check": "tsx tools/generate-protocol/src/cli.ts --check",
    "contract:verify": "python tools/contract-sync/verify.py",
    "contract:sync": "python tools/contract-sync/sync.py",
    "contract:advisory": "python tools/contract-sync/advisory.py",
    "oracle:bootstrap": "python conformance/runners/python/bootstrap.py",
    "oracle:check": "python conformance/runners/python/run.py --check",
    "oracle:export": "python conformance/runners/python/run.py --export",
    "oracle:export:check": "python conformance/runners/python/run.py --export-check",
    "conformance": "tsx packages/conformance-runner/src/cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@modelcontextprotocol/fastify": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@types/node": "^24.3.0",
    "@types/better-sqlite3": "9.6.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "13.0.3",
    "canonicalize": "^2.1.0",
    "eslint": "^9.33.0",
    "fastify": "^5.5.0",
    "globals": "^16.3.0",
    "openapi-typescript": "^7.9.1",
    "prettier": "^3.6.2",
    "sqlite-vec": "0.1.9",
    "tsdown": "^0.16.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.4",
    "yaml": "^2.8.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
