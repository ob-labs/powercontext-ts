{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://powercontext.local/conformance/manifest.schema.json",
  "title": "PowerContext conformance manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract_version", "baseline_commit", "capabilities"],
  "properties": {
    "schema": { "const": "powercontext.conformance.manifest.v1" },
    "contract_version": { "type": "integer", "minimum": 1 },
    "baseline_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability",
          "required_level",
          "profiles",
          "fixtures",
          "implementations"
        ],
        "properties": {
          "capability": { "type": "string" },
          "required_level": {
            "type": "string",
            "enum": ["C0", "C1", "C2", "C3", "C4", "C5"]
          },
          "profiles": {
            "type": "array",
            "items": { "type": "string" }
          },
          "fixtures": {
            "type": "array",
            "items": { "type": "string" }
          },
          "implementations": {
            "type": "object",
            "additionalProperties": false,
            "required": ["python", "typescript"],
            "properties": {
              "python": { "enum": ["required", "optional"] },
              "typescript": { "enum": ["required", "optional"] }
            }
          }
        }
      }
    }
  }
}
