{
  "name": "@powercontext/server",
  "version": "0.0.0",
  "description": "HTTP, MCP, Dashboard and observability composition.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@powercontext/builtin": "workspace:*",
    "@powercontext/protocol": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
