{
  "name": "@powercontext/core",
  "version": "0.0.0",
  "description": "Deterministic Source, Artifact, Trigger and canonical domain helpers.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "canonicalize": "^2.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
